<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="上班时间"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TimePicker
            android:id="@+id/tpStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="下班时间"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TimePicker
            android:id="@+id/tpEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="提醒间隔：上班提前、下班延后（未打卡时提醒）"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spLead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="打卡提醒"
                android:textColor="#333333"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/swRemind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="后台自动刷新（普通模式可能打开企微）"
                android:textColor="#333333"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/swAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="自动刷新间隔（刷新时段：02:00-11:00 / 17:00-01:00，周末及法定节假日不刷新）"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="刷新后自动返回原界面"
                android:textColor="#333333"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/swBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="状态读取模式" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333" />
        <RadioGroup android:id="@+id/readMode" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/modeRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Root 模式" />
            <RadioButton android:id="@+id/modeNormal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="普通模式" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#666666"
            android:text="Root 模式：优先读取本地考勤记录，失败时使用页面识别。需要 Root 授权。\n普通模式：使用无障碍读取企微打卡页面，刷新时可能打开企微；需要手机解锁及无障碍权限。\n首次运行自动检测；Root 不可用时自动切换普通模式。" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
